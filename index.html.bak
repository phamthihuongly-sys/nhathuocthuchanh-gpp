<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tủ thuốc mô phỏng – Môn Dược lý</title>
<style>
  :root{
    --wood:#123a2f;
    --wood-light:#1f5346;
    --wood-dark:#0b241d;
    --trim:#f3efe2;
    --gold:#e8c873;
    --paper:#f7f4ea;
    --ink:#1c3c33;
    --muted:#7a7a6a;
    --box-w:122px;
    --tu-w:560px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;height:100%;}
  body{
    font-family:"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    background:radial-gradient(ellipse at 50% -10%, #e9ede4 0%, #cfd8ce 55%, #b9c4b7 100%);
    color:var(--ink);
    height:100vh;overflow:hidden;
    display:flex;flex-direction:column;
    padding:14px 16px 10px;
  }

  /* ---------- Header / toolbar ---------- */
  .page-head{max-width:100%;margin:0 auto 8px;text-align:center;flex:none;}
  .page-head h1{
    font-size:1.4rem;letter-spacing:.03em;color:var(--wood-dark);margin:0 0 4px;font-weight:700;
    display:flex;align-items:center;justify-content:center;gap:10px;
  }
  .page-head p{margin:0;color:var(--muted);font-size:.88rem;}
  .mascot{
    display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;
    background:linear-gradient(160deg,var(--wood-light),var(--wood));border-radius:50%;
    box-shadow:0 3px 6px rgba(0,0,0,.3), inset 0 0 0 2px rgba(255,255,255,.25);
    animation:mascot-bounce 2.4s ease-in-out infinite;flex:none;
  }
  .mascot::before{
    content:"";width:16px;height:16px;background:
      linear-gradient(var(--gold),var(--gold)) center/100% 34% no-repeat,
      linear-gradient(var(--gold),var(--gold)) center/34% 100% no-repeat;
  }
  @keyframes mascot-bounce{0%,100%{transform:translateY(0) rotate(0);}50%{transform:translateY(-4px) rotate(-6deg);}}

  .toolbar{
    max-width:100%;margin:0 auto 10px;display:flex;flex-wrap:wrap;gap:10px;
    align-items:center;justify-content:space-between;
    background:var(--paper);border-radius:10px;padding:10px 14px;
    box-shadow:0 2px 10px rgba(0,0,0,.12);
    flex:none;
  }
  .toolbar input[type=search]{
    flex:1;min-width:200px;padding:9px 12px;border-radius:20px;border:1px solid #d8d3c2;
    font-size:.9rem;outline:none;
  }
  .toolbar input[type=search]:focus{border-color:var(--wood-light);box-shadow:0 0 0 2px rgba(31,83,70,.15);}
  .cabinet-jump{
    padding:9px 12px;border-radius:20px;border:1px solid #d8d3c2;background:#fff;
    font-size:.85rem;color:var(--ink);outline:none;max-width:220px;cursor:pointer;
  }
  .cabinet-jump:focus{border-color:var(--wood-light);box-shadow:0 0 0 2px rgba(31,83,70,.15);}
  .stats{display:flex;gap:8px;flex-wrap:wrap;}
  .chip{background:var(--wood);color:#fff;font-size:.72rem;padding:5px 10px;border-radius:14px;white-space:nowrap;}
  .chip b{color:var(--gold);}

  .search-results{
    max-width:100%;margin:0 auto 10px;display:none;flex-wrap:wrap;gap:6px;
    background:var(--paper);border-radius:10px;padding:10px 14px;box-shadow:0 2px 10px rgba(0,0,0,.12);
    flex:none;max-height:22vh;overflow-y:auto;
  }
  .search-results.show{display:flex;}
  .search-results .sr-count{width:100%;font-size:.72rem;color:var(--muted);margin-bottom:2px;}
  .search-results button{
    border:1px solid var(--wood-light);background:#fff;color:var(--wood-dark);
    border-radius:14px;padding:5px 12px;font-size:.74rem;cursor:pointer;text-align:left;
  }
  .search-results button:hover{background:var(--wood-light);color:#fff;}
  .search-results button b{font-weight:700;}
  .search-results button .sr-buoi{opacity:.75;font-size:.68rem;margin-left:4px;}
  .search-results .sr-empty{font-size:.78rem;color:var(--muted);}

  /* ---------- Pharmacy scene ---------- */
  .pharmacy-scene{
    max-width:100%;margin:0 auto;position:relative;border-radius:14px;overflow:hidden;
    background:
      radial-gradient(ellipse 60px 60px at 0 0, rgba(255,255,255,.35) 0 2px, transparent 3px) 0 0/60px 60px,
      radial-gradient(ellipse 60px 60px at 30px 30px, rgba(255,255,255,.35) 0 2px, transparent 3px) 0 0/60px 60px,
      linear-gradient(180deg,#e4e9df 0%, #e4e9df 72%, #cdbd93 72%, #b9a878 100%);
    box-shadow:0 12px 32px rgba(0,0,0,.18);
    padding:16px 18px 0;
    flex:1;min-height:0;display:flex;flex-direction:column;
  }
  .pharmacy-scene::before{ /* ceiling spotlights */
    content:"";position:absolute;top:0;left:0;right:0;height:60px;pointer-events:none;z-index:1;
    background:
      radial-gradient(ellipse 90px 40px at 12% 0%, rgba(255,255,255,.55), transparent 70%),
      radial-gradient(ellipse 90px 40px at 38% 0%, rgba(255,255,255,.5), transparent 70%),
      radial-gradient(ellipse 90px 40px at 64% 0%, rgba(255,255,255,.5), transparent 70%),
      radial-gradient(ellipse 90px 40px at 90% 0%, rgba(255,255,255,.55), transparent 70%);
  }
  .pharmacy-scene::after{ /* wood-plank floor seams */
    content:"";position:absolute;left:0;right:0;bottom:0;height:28%;pointer-events:none;z-index:0;
    background:repeating-linear-gradient(90deg, rgba(0,0,0,.06) 0 2px, transparent 2px 84px);
  }

  .cabinets-row{
    display:flex;gap:12px;overflow-x:auto;overflow-y:hidden;padding:0 4px 14px;align-items:stretch;
    scroll-snap-type:x proximity; position:relative; z-index:1;
    flex:1;min-height:0;
  }
  .cabinets-row::-webkit-scrollbar{height:8px;}
  .cabinets-row::-webkit-scrollbar-thumb{background:#00000030;border-radius:4px;}

  .tu-thuoc{
    scroll-snap-align:start;flex:0 0 var(--tu-w);display:flex;flex-direction:column;
    filter:drop-shadow(0 10px 8px rgba(0,0,0,.28));
  }
  .tu-awning{
    height:14px;margin:0 4px;border-radius:6px 6px 0 0;position:relative;
    box-shadow:0 3px 4px rgba(0,0,0,.35);
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,.3) 0 3px, rgba(0,0,0,.14) 3px 7px, transparent 7px 14px),
      linear-gradient(-45deg, var(--wood-dark) 7px, transparent 0) 0 6px / 14px 8px repeat-x,
      linear-gradient(45deg, var(--wood-dark) 7px, transparent 0) 0 6px / 14px 8px repeat-x,
      repeating-linear-gradient(90deg, var(--wood-light) 0 14px, var(--trim) 14px 28px);
  }
  .tu-plaque{
    align-self:center;max-width:88%;background:linear-gradient(160deg,var(--wood-dark),#081b15);color:var(--gold);font-size:.68rem;
    letter-spacing:.03em;padding:4px 12px;border-radius:0 0 8px 8px;font-weight:700;
    margin-top:-1px;box-shadow:0 3px 4px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.15);
    text-align:center;line-height:1.25;
    overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  }
  .tu-cornice{
    height:12px;background:repeating-linear-gradient(90deg,var(--wood-dark) 0 14px,var(--wood) 14px 28px);
    box-shadow:0 2px 3px rgba(0,0,0,.35) inset, 0 2px 3px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.2);
  }
  .tu-frame{
    background:linear-gradient(160deg,#fffdf7,var(--trim) 40%,#e7e0cc);padding:6px;box-shadow:0 2px 4px rgba(0,0,0,.2);
    flex:1;min-height:0;display:flex;flex-direction:column;
  }
  .tu-glass{
    position:relative;background:linear-gradient(160deg,var(--wood-light),var(--wood) 55%,var(--wood-dark));
    border-radius:8px;overflow:visible;
    padding:8px 8px 4px;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);
    flex:1;min-height:0;display:flex;flex-direction:column;
  }
  .tu-glass::after{
    content:"";position:absolute;inset:0;pointer-events:none;z-index:2;
    background:linear-gradient(115deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,0) 16%,rgba(255,255,255,0) 84%,rgba(255,255,255,.08) 100%);
  }
  .tu-glass.flash{box-shadow:0 0 0 3px var(--gold), inset 0 0 0 1px rgba(255,255,255,.08);}
  .shelf-row{
    display:flex;gap:5px;justify-content:flex-start;align-items:stretch;
    flex:1;min-height:0;box-sizing:border-box;
    padding:6px 6px 9px;margin-bottom:8px;border-radius:9px;
    background:linear-gradient(180deg, rgba(255,255,255,.09) 0%, rgba(255,255,255,.02) 45%, rgba(255,255,255,0) 100%);
    border-bottom:2px solid rgba(255,255,255,.4);
    box-shadow:0 2px 3px rgba(0,0,0,.25);
  }
  .shelf-row:last-child{border-bottom:none;margin-bottom:0;box-shadow:none;}
  .tu-topic{
    color:rgba(255,255,255,.55);font-size:.58rem;text-align:center;padding:3px 6px 0;
    line-height:1.2;flex:none;
  }
  .tu-base{
    height:14px;background:repeating-linear-gradient(90deg,var(--wood-dark) 0 14px,var(--wood) 14px 28px);
    border-radius:0 0 4px 4px;box-shadow:0 3px 8px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.2), inset 0 -2px 3px rgba(0,0,0,.35);
  }

  /* ---------- medicine boxes (real carton look, name printed on box) ---------- */
  .med-item{
    position:relative;background:none;border:none;padding:0;cursor:pointer;
    display:block;height:100%;width:var(--box-w);flex:none;
    transition:transform .12s;
  }
  .med-item:hover, .med-item:focus-visible{ transform:translateY(-3px); outline:none; z-index:3;}
  .med-item::after{ /* contact shadow so every box reads as standing on the shelf, not floating */
    content:"";position:absolute;left:12%;right:12%;top:100%;margin-top:-2px;height:6px;
    background:radial-gradient(ellipse,rgba(0,0,0,.5) 0%,rgba(0,0,0,0) 72%);pointer-events:none;
  }
  .med-item .icon{display:block;position:relative;width:100%;height:100%;overflow:hidden;border-radius:7px;}
  .med-item .photo-dot{
    position:absolute;top:-3px;right:-3px;width:7px;height:7px;border-radius:50%;
    background:#5fd38d;box-shadow:0 0 0 1px rgba(0,0,0,.4);z-index:2;
  }
  .med-item.dim{opacity:.12;pointer-events:none;}
  .med-item.hit .icon{box-shadow:0 0 0 2px var(--gold), 0 0 8px 1px var(--gold);border-radius:7px;}
  .med-item .real-photo{
    position:absolute;inset:0;width:100%;height:100%;object-fit:contain;
    background:var(--paper);z-index:1;
  }
  .qty-badge{
    position:absolute;bottom:-6px;right:-7px;z-index:3;
    background:var(--wood-dark);color:var(--gold);font-size:12px;font-weight:700;
    padding:2px 6px;border-radius:10px;box-shadow:0 1px 4px rgba(0,0,0,.55);
    white-space:nowrap;
  }
  .qty-badge.out-of-stock-badge{
    background:#7a2020;color:#ffd9d9;font-size:10.5px;right:auto;left:50%;transform:translateX(-50%);
  }
  .med-item.out-of-stock{cursor:default;}
  .med-item.out-of-stock .icon{opacity:.45;filter:grayscale(1);}

  /* single unified shape: a small pharma carton with the drug name printed on it,
     with a bit of simulated 3D volume (gloss sheen + embossed band + grounded shadow) */
  .shape-medbox{
    position:absolute;inset:0;border-radius:7px;overflow:hidden;
    background:var(--paper);
    box-shadow: inset 0 -7px 9px -5px rgba(0,0,0,.28);
    display:flex;flex-direction:column;
  }
  .shape-medbox::after{ /* glossy diagonal sheen, like light catching the carton */
    content:"";position:absolute;inset:0;pointer-events:none;z-index:1;
    background:linear-gradient(115deg, rgba(255,255,255,.5) 0%, rgba(255,255,255,0) 32%, rgba(255,255,255,0) 68%, rgba(255,255,255,.1) 100%);
  }
  .shape-medbox .band{
    height:32%;position:relative;flex:none;
    display:flex;align-items:center;justify-content:center;
    background:
      radial-gradient(130% 190% at 32% -25%, rgba(255,255,255,.6), transparent 55%),
      linear-gradient(160deg,var(--c),var(--c2));
    box-shadow:inset 0 -3px 4px -2px rgba(0,0,0,.35), inset 0 2px 0 rgba(255,255,255,.3);
  }
  .shape-medbox .band::before{
    content:"";width:12px;height:12px;position:relative;z-index:1;background:
      linear-gradient(rgba(255,255,255,.9),rgba(255,255,255,.9)) center/100% 26% no-repeat,
      linear-gradient(rgba(255,255,255,.9),rgba(255,255,255,.9)) center/26% 100% no-repeat;
    opacity:.85;filter:drop-shadow(0 1px 1px rgba(0,0,0,.3));
  }
  .shape-medbox .label{
    flex:1;display:flex;align-items:center;justify-content:center;padding:2px 4px;
    font-size:9.5px;line-height:1.15;font-weight:700;color:var(--ink);text-align:center;
    overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;
    word-break:break-word;
  }
  .shape-medbox .barcode{
    height:3px;flex:none;margin:0 5px 3px;
    background:repeating-linear-gradient(90deg,#0003 0 1px,transparent 1px 2.4px);
  }

  .empty-note{padding:10px;font-size:.68rem;color:rgba(255,255,255,.6);}

  .floor-strip{height:14px;position:relative;z-index:0;}

  /* ---------- hover tooltip ---------- */
  #tooltip{
    position:fixed;z-index:80;pointer-events:none;max-width:260px;
    background:rgba(15,30,24,.96);color:#fbf9f3;border-radius:8px;padding:8px 10px;
    font-size:.74rem;line-height:1.4;box-shadow:0 8px 22px rgba(0,0,0,.4);
    opacity:0;transform:translateY(4px);transition:opacity .1s,transform .1s;
  }
  #tooltip[data-mode="interactive"]{max-width:420px;font-size:.86rem;}
  #tooltip[data-mode="interactive"] .t-photo{max-width:100%;}
  #tooltip[data-mode="interactive"] .t-name{font-size:1rem;}
  #tooltip .fefo-list{margin-top:8px;display:flex;flex-direction:column;gap:5px;}
  #tooltip .fefo-row{
    display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;
    background:rgba(255,255,255,.07);border-radius:6px;padding:6px 9px;
  }
  #tooltip .fefo-pos{font-weight:700;color:var(--gold);font-size:.78rem;white-space:nowrap;}
  #tooltip .fefo-meta{font-size:.78rem;color:#d8d8ce;white-space:nowrap;}
  #tooltip .fefo-move{display:flex;gap:3px;flex:none;}
  #tooltip .fefo-move button{
    background:rgba(255,255,255,.15);border:none;color:#fbf9f3;width:24px;height:24px;
    border-radius:4px;cursor:pointer;font-size:.72rem;line-height:1;
  }
  #tooltip .fefo-move button:hover:not(:disabled){background:var(--gold);color:var(--wood-dark);}
  #tooltip .fefo-move button:disabled{opacity:.25;cursor:default;}
  #tooltip .fefo-feedback{margin-top:6px;font-size:.76rem;padding:5px 8px;border-radius:5px;animation:cheer .35s ease;}
  #tooltip .fefo-feedback.ok{background:rgba(95,211,141,.2);color:#8fe6b3;}
  #tooltip .fefo-feedback.bad{background:rgba(230,120,120,.2);color:#f0a3a3;}
  @keyframes cheer{0%{transform:scale(.85);opacity:0;}60%{transform:scale(1.06);opacity:1;}100%{transform:scale(1);}}
  #tooltip .fefo-actions{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;}
  #tooltip .fefo-actions button{
    flex:1;background:var(--gold);color:var(--wood-dark);border:none;border-radius:14px;
    padding:7px 10px;font-size:.76rem;font-weight:700;cursor:pointer;white-space:nowrap;
  }
  #tooltip .fefo-actions button:hover{background:#f3d998;}
  #tooltip .fefo-export{
    margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,.12);
    display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  }
  #tooltip .fefo-export label{font-size:.76rem;color:#d8d8ce;display:flex;align-items:center;gap:5px;}
  #tooltip .fefo-qty{
    width:46px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);
    color:#fbf9f3;border-radius:4px;padding:4px 5px;font-size:.78rem;text-align:center;
  }
  #tooltip .fefo-export button[data-act="export"]{
    background:#e0e6df;color:var(--wood-dark);border:none;border-radius:14px;
    padding:7px 12px;font-size:.76rem;font-weight:700;cursor:pointer;
  }
  #tooltip .fefo-export button[data-act="export"]:hover{background:#fff;}
  #tooltip .fefo-export-hint{width:100%;font-size:.68rem;color:#9fb3ab;}
  #tooltip.show{opacity:1;transform:translateY(0);}
  #tooltip .t-photo{
    display:block;width:100%;max-width:240px;height:auto;border-radius:6px;
    margin-bottom:6px;background:#fff;box-shadow:0 4px 14px rgba(0,0,0,.45);
  }
  #tooltip .t-name{font-weight:700;font-size:.8rem;color:var(--gold);}
  #tooltip .t-brand{color:#cfe0d8;font-style:italic;margin-top:1px;}
  #tooltip .t-row{color:#d8d8ce;margin-top:3px;font-size:.68rem;}
  #tooltip .t-hint{margin-top:5px;color:#9fb3ab;font-size:.62rem;}
  #tooltip[data-mode="interactive"] .t-row{font-size:.8rem;}
  #tooltip[data-mode="interactive"] .t-hint{font-size:.68rem;}

  /* ---------- Modal (full detail on click) ---------- */
  .overlay{position:fixed;inset:0;background:rgba(10,20,15,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:90;}
  .overlay.open{display:flex;}
  .modal{background:var(--paper);border-radius:12px;max-width:460px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.4);overflow:hidden;animation:pop .15s ease-out;}
  @keyframes pop{from{transform:scale(.92);opacity:0;}to{transform:scale(1);opacity:1;}}
  .modal-head{background:linear-gradient(135deg,var(--wood-light),var(--wood));color:#fff;padding:14px 16px;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
  .modal-head h2{margin:0;font-size:1.05rem;}
  .modal-head .sub{font-size:.72rem;opacity:.85;margin-top:2px;}
  .modal-head button{background:rgba(255,255,255,.15);border:none;color:#fff;width:26px;height:26px;border-radius:50%;cursor:pointer;font-size:.9rem;line-height:1;flex:none;}
  .modal-head button:hover{background:rgba(255,255,255,.3);}
  .modal-body{padding:14px 16px;}
  .modal-body dl{margin:0;display:grid;grid-template-columns:120px 1fr;gap:7px 10px;font-size:.82rem;}
  .modal-body dt{color:var(--muted);}
  .modal-body dd{margin:0;}
  .modal-body dd.missing{color:#b6ac93;font-style:italic;}
  #mFefo{margin-top:14px;padding-top:12px;border-top:1px dashed #d8d3c2;}
  #mFefo .fefo-title{font-size:.78rem;font-weight:700;color:var(--wood-dark);margin-bottom:2px;}
  #mFefo .fefo-note{font-size:.68rem;color:var(--muted);margin-bottom:8px;}
  #mFefo table{width:100%;border-collapse:collapse;font-size:.76rem;}
  #mFefo th{text-align:left;color:var(--muted);font-weight:600;padding:3px 6px;font-size:.68rem;}
  #mFefo td{padding:5px 6px;border-top:1px solid #ece7d8;}
  #mFefo tr.soonest td{background:#fdf2d6;font-weight:600;}
  #mFefo .tag{font-size:.62rem;padding:1px 6px;border-radius:8px;background:var(--wood);color:#fff;}
  .modal-foot{padding:12px 16px 16px;display:flex;gap:8px;flex-wrap:wrap;}
  .modal-foot a{text-decoration:none;background:var(--wood);color:#fff;padding:8px 14px;border-radius:18px;font-size:.8rem;}
  .modal-foot a:hover{background:var(--wood-light);}
</style>
</head>
<body>

<div class="page-head">
  <h1><span class="mascot" aria-hidden="true"></span>NHÀ THUỐC THỰC HÀNH — TỦ THUỐC MÔN DƯỢC LÝ</h1>
</div>

<div class="toolbar">
  <input type="search" id="searchInput" placeholder="🔍 Tìm tên hoạt chất, tên biệt dược, tên tủ...">
  <select id="cabinetJump" class="cabinet-jump"><option value="">📦 Đến tủ...</option></select>
  <div class="stats" id="statsBar"></div>
</div>

<div class="search-results" id="searchResults"></div>

<div class="pharmacy-scene">
  <div class="cabinets-row" id="cabinetsRow"></div>
  <div class="floor-strip"></div>
</div>

<div id="tooltip"></div>

<div class="overlay" id="overlay">
  <div class="modal">
    <div class="modal-head">
      <div>
        <h2 id="mName">—</h2>
        <div class="sub" id="mBrand"></div>
      </div>
      <button id="mClose">✕</button>
    </div>
    <div class="modal-body"><dl id="mFields"></dl><div id="mFefo"></div></div>
    <div class="modal-foot" id="mFoot"></div>
  </div>
</div>

<script>
const CSV_DATA = `STT Buổi,Tên Bài,Tên hoạt chất,Tên biệt dược,Dạng bào chế,Đường dùng,Nơi sản xuất,Nước sản xuất,Số kiểm soát,Số đăng ký,Hạn sử dụng,Điều kiện bảo quản,Cấp độ ,Link google drive
Buổi 2,THUỐC TÁC DỤNG TRÊN TKTV,Metoprolol vỉ,,,,,,,,,,1,
